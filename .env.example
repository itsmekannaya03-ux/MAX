# MAX (My AI eXecutive Assistant) Configuration

# Server Settings
PORT=8000
HOST=127.0.0.1
DEBUG=True

# AI Provider Settings: "gemini" | "openai" | "groq" | "ollama" | "offline"
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# API Keys (leave empty to use built-in offline intelligence engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Voice Settings
DEFAULT_TTS_VOICE=en-US-JennyNeural
DEFAULT_TTS_SPEED=1.0

# Productivity & Privacy Settings
ALLOW_WEBCAM_MONITORING=false
WEBCAM_INTERVAL_SECONDS=60
ACTIVITY_MONITOR_ENABLED=true
IDLE_THRESHOLD_SECONDS=300

# Storage
DATABASE_URL=sqlite:///./max_assistant.db
